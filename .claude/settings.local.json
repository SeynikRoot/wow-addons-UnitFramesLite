{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$json = $input | Out-String | ConvertFrom-Json; $f = $json.tool_input.file_path; if ($f -match \"\\.(lua|xml|toc)$\") { powershell -ExecutionPolicy Bypass -File \"c:/Repos/UnitFramesLite/deploy-addon.ps1\" -WoWPath \"D:/Games/World of Warcraft\" -GameType retail }",
            "timeout": 30,
            "statusMessage": "Deploying addon to WoW..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(powershell.exe -ExecutionPolicy Bypass -File \"C:\\\\Repos\\\\UnitFramesLite\\\\deploy-addon.ps1\" -WoWPath \"D:\\\\Games\\\\World of Warcraft\" -GameType retail)",
      "Read(//d/Games/World of Warcraft/**)",
      "Read(//d/Games/**)",
      "Bash(grep -r \"ComboPoint\\\\|HolyPower\\\\|ClassNamePower\\\\|PlayerPower\\\\|ResourceBar\" 'D:/Games/World of Warcraft/_retail_/Interface/AddOns' --include=*.lua)",
      "Bash(grep -r \"PointBarFrame\\\\|PowerFrame\\\\|RuneFrame\\\\|SoulShardFrame\" 'D:/Games/World of Warcraft/_retail_/Interface/AddOns' --include=*.lua)",
      "Bash(grep -rh _G[ 'D:/Games/World of Warcraft/_retail_/Interface/AddOns' --include=*.lua)",
      "Bash(grep -rn \"PlayerPowerBar\\\\|SecondaryPowerBar\" 'D:/Games/World of Warcraft/_retail_/Interface/AddOns' --include=*.lua)",
      "Bash(grep -rh \"PlayerPowerBar\\\\|EssencePlayer\\\\|MageArcane\\\\|MonkHarmony\\\\|PaladinPower\" 'D:/Games/World of Warcraft/_retail_/Interface/AddOns' --include=*.lua)",
      "Bash(grep -rh \"Alternate\\\\|Secondary\" 'D:/Games/World of Warcraft/_retail_/Interface/AddOns/BetterBlizzFrames' --include=*.lua)",
      "Bash(grep -rh \"MonkStagger\\\\|EvokerEbonMight\\\\|DemonHunterSoulFragments\" 'D:/Games/World of Warcraft/_retail_/Interface/AddOns/BetterBlizzFrames' --include=*.lua)",
      "Bash(grep -rn DEMONHUNTER 'D:/Games/World of Warcraft/_retail_/Interface/AddOns/BetterBlizzFrames' --include=*.lua)"
    ]
  }
}
